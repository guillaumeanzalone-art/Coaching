+function monsterEncounterOddsFallback() {
+  // V176 — copie de secours EXACTE de la formule serveur V175.
+  // Elle n'est utilisée que si le RPC Supabase est momentanément indisponible.
+  const chancePoints = Math.min(1500, Math.max(0, effectiveChancePoints()));
+  const hunterBonus = Math.min(100, Math.max(0, equippedPassiveTotal('epic_hunter')));
+
+  const uncommonMultiplier = 1 + chancePoints / 750;
+  const rarePlusMultiplier = 1 + chancePoints / 500;
+  const hunterMultiplier = 1 + hunterBonus / 100;
+
+  const weights = {
+    normal: 67.339,
+    common: 27,
+    uncommon: 4 * uncommonMultiplier,
+    rare: 1 * rarePlusMultiplier * hunterMultiplier,
+    epic: 0.5 * rarePlusMultiplier * hunterMultiplier,
+    legendary: 0.1 * rarePlusMultiplier * hunterMultiplier,
+    mythic: 0.05 * rarePlusMultiplier * hunterMultiplier,
+    ultra_mythic: 0.01 * rarePlusMultiplier * hunterMultiplier,
+    abyssal: 0.001 * rarePlusMultiplier * hunterMultiplier
+  };
+
+  const totalWeight = Object.values(weights).reduce((sum, value) => sum + value, 0);
+  if (!(totalWeight > 0)) return {
+    normal: 67.339,
+    common: 27,
+    uncommon: 4,
+    rare: 1,
+    epic: 0.5,
+    legendary: 0.1,
+    mythic: 0.05,
+    ultra_mythic: 0.01,
+    abyssal: 0.001
+  };
+
+  return Object.fromEntries(
+    Object.entries(weights).map(([key, value]) => [key, value / totalWeight * 100])
+  );
+}
+
+function monsterEncounterOdds() {
+  return serverEncounterOdds || monsterEncounterOddsFallback();
+}
+
+async function loadServerEncounterOdds() {
+  if (!window.CoachingCloud?.client || !CoachingCloud.session?.user) {
+    return serverEncounterOdds;
+  }
+
+  // Plusieurs chargements (progression / inventaire / codex) peuvent arriver
+  // en même temps. Un seul RPC est lancé et les autres attendent le même.
+  if (serverEncounterOddsPromise) return serverEncounterOddsPromise;
+
+  serverEncounterOddsPromise = (async () => {
+    const { data, error } = await CoachingCloud.client.rpc(
+      'rpg_monster_encounter_odds_v153',
+      {
+        p_athlete_slug: cfg.slug,
+        p_player_level: Math.max(1, Math.floor(n(progress?.level, 1)))
+      }
+    );
+
+    if (error) {
+      console.warn('Probabilités monstres serveur indisponibles :', error.message);
+      return serverEncounterOdds;
+    }
+
+    const rows = Array.isArray(data) ? data : data ? [data] : [];
+    if (!rows.length) {
+      console.warn('Probabilités monstres serveur vides.');
+      return serverEncounterOdds;
+    }
+
+    // Une rareté absente de la réponse serveur doit apparaître à 0 %,
+    // et surtout ne jamais être recréée artificiellement côté navigateur.
+    const next = {
+      normal: 0,
+      common: 0,
+      uncommon: 0,
+      rare: 0,
+      epic: 0,
+      legendary: 0,
+      mythic: 0,
+      ultra_mythic: 0,
+      abyssal: 0
+    };
+
+    for (const row of rows) {
+      const key = normalizedMonsterRarity(row?.rarity);
+      const pct = Number(row?.chance_pct);
+      if (Object.prototype.hasOwnProperty.call(next, key) && Number.isFinite(pct)) {
+        next[key] = pct;
+      }
+    }
+
+    serverEncounterOdds = next;
+    return serverEncounterOdds;
+  })();
+
+  try {
+    return await serverEncounterOddsPromise;
+  } finally {
+    serverEncounterOddsPromise = null;
+  }
+}
